# Copie este arquivo para ".env" e preencha com as credenciais reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

TOTVS_RM_BASE_URL=https://SEU-TENANT.rm.cloudtotvs.com.br:PORTA
TOTVS_RM_USERNAME=usuario_de_integracao
TOTVS_RM_PASSWORD=senha_de_integracao

# --- Portal web (V2 — Django) ---
# DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-em-producao   (opcional em dev, tem default)
# DJANGO_ALLOWED_HOSTS=*                                         (opcional em dev, tem default)
# DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco  (opcional em dev, tem default)

# DEBUG tem default seguro (False/produção) — descomente pra dev local, senão
# mídia, estáticos e traceback de erro não funcionam no portal.
DJANGO_DEBUG=1
